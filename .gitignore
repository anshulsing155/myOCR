.env
.env.local
.env.production
!.env.example
*.key

# Test & coverage artefacts
.pytest_cache/
.coverage
htmlcov/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Claude Code session data
.claude/

